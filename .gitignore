# Secrets propres a chaque environnement : ne jamais committer.
config.php
config_dev.php
config_prod.php
service-account.json

# Fichiers systeme
.DS_Store
Thumbs.db

# Utilitaire a usage unique (ne doit jamais rester en ligne ni dans l'historique)
generate_password.php.bak
 
# Sauvegardes automatiques (donnees, generees par backup.php, jamais committees)
backups/*.json
# Fichiers SQL generes dans backups/ (ex: outils/reprendre_medicaments.php) :
# ce sont des donnees de sante reelles, au meme titre que les .json.
backups/*.sql

# Script de deploiement FTP (deploiement/deployer.php) : contient un mot
# de passe, propre a chaque environnement.
deploiement/deploy.config.php

# Photos de medicaments uploadees (donnees personnelles, jamais
# committees) - le dossier lui-meme (.htaccess/.gitkeep) reste versionne.
medicaments_photos/*
!medicaments_photos/.htaccess
!medicaments_photos/.gitkeep